+
+/// VIII experiment: WASI Preview 1 has no mmap (memmap2 returns
+/// `Unsupported`), so the whole file is read into linear memory. Parsing stays
+/// lazy, but resident memory is at least the input size. Reads use 64 KiB
+/// requests: one huge read made Wasmtime on Windows fail with ENOMEM (the
+/// same failure workers/pdf avoids with bounded reads).
+#[cfg(target_os = "wasi")]
+pub(crate) fn map_file(path: &Path) -> Result<Vec<u8>> {
+    use std::io::Read;
+    let mut file = File::open(path)?;
+    let expected = file.metadata()?.len() as usize;
+    let mut bytes = Vec::new();
+    bytes
+        .try_reserve_exact(expected)
+        .map_err(|e| std::io::Error::new(std::io::ErrorKind::OutOfMemory, e))?;
+    let mut block = vec![0u8; 64 * 1024];
+    loop {
+        let n = match file.read(&mut block) {
+            Err(e) if e.kind() == std::io::ErrorKind::Interrupted => continue,
+            r => r?,
+        };
+        if n == 0 {
+            break;
+        }
+        if bytes.len() + n > expected {
+            return Err(std::io::Error::other("input grew while reading").into());
+        }
+        bytes.extend_from_slice(&block[..n]);
+    }
+    if bytes.len() != expected {
+        return Err(std::io::Error::new(std::io::ErrorKind::UnexpectedEof, "short read").into());
+    }
+    Ok(bytes)
+}
